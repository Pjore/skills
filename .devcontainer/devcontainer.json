{
  "name": "skills",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-trixie",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-pull-request-github",
        "github.copilot-chat",
        "streetsidesoftware.code-spell-checker",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true
        },
        "search.exclude": {
          "**/node_modules": true,
          "**/*.code-search": true
        }
      }
    }
  },
  "onCreateCommand": "npx -y @sentry/dotagents@latest install",
  "postStartCommand": "npx -y @sentry/dotagents@latest sync",
  "remoteUser": "node"
}
